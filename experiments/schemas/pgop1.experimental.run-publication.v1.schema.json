{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pgop1.experimental.run-publication.v1",
  "title": "PGOP1 experimental RUN publication receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "template_only", "receipt_id", "record_kind", "RUN_ID",
    "RUN_CONTRACT_VERSION", "EXECUTED_CODE_COMMIT", "EXECUTED_CODE_TREE",
    "SOURCE_MANIFEST_SHA256", "RESULTS_MANIFEST_SHA256", "EXECUTION_STATUS",
    "AUDIT_STATUS", "PUBLICATION_COMMIT", "PUBLICATION_BRANCH", "PUBLIC_FILES",
    "WITHHELD_FILES", "REDISTRIBUTION_STATUS", "REMOTE_VERIFICATION_STATUS",
    "CAMPAIGN_LIFECYCLE_STATUS", "CAMPAIGN_LIFECYCLE_HISTORY", "PUBLICATION_LIFECYCLE_STATUS",
    "REPRODUCIBILITY_CLASS", "REQUIRED_RESULT_SET", "publication", "scope", "lineage"
  ],
  "properties": {
    "schema": {"const": "pgop1.experimental.run-publication.v1"},
    "template_only": {"const": false},
    "receipt_id": {"type": "string", "minLength": 1},
    "record_kind": {"enum": ["HISTORICAL_RECONSTRUCTION", "PROSPECTIVE_CAMPAIGN"]},
    "RUN_ID": {"type": "string", "pattern": "^RUN-[0-9]{3,}$"},
    "RUN_CONTRACT_VERSION": {"type": "string", "minLength": 1},
    "EXECUTED_CODE_COMMIT": {"type": "string", "minLength": 1},
    "EXECUTED_CODE_TREE": {"type": "string", "minLength": 1},
    "SOURCE_MANIFEST_SHA256": {"type": "string", "minLength": 1},
    "RESULTS_MANIFEST_SHA256": {"type": "string", "minLength": 1},
    "EXECUTION_STATUS": {"type": "string", "minLength": 1},
    "AUDIT_STATUS": {"type": "string", "minLength": 1},
    "PUBLICATION_COMMIT": {"type": "string", "minLength": 1},
    "PUBLICATION_BRANCH": {"type": "string", "minLength": 1},
    "PUBLIC_FILES": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "WITHHELD_FILES": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "REDISTRIBUTION_STATUS": {"type": "string", "minLength": 1},
    "REMOTE_VERIFICATION_STATUS": {"type": "string", "minLength": 1},
    "CAMPAIGN_LIFECYCLE_STATUS": {"enum": [
      "RUN_PREPARED", "RUN_FROZEN", "RUN_EXECUTED", "RUN_EXECUTION_PARTIAL",
      "RESULTS_VERIFIED", "ENGINEERING_AUDITED", "PUBLICATION_PREPARED",
      "PUBLICATION_BLOCKED", "PUBLICATION_VERIFIED", "RUN_DOCUMENTARY_CLOSED",
      "UNKNOWN_HISTORICAL_STAGE"
    ]},
    "CAMPAIGN_LIFECYCLE_HISTORY": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
    "PUBLICATION_LIFECYCLE_STATUS": {"enum": ["NOT_PREPARED", "PREPARATION_BLOCKED", "PREPARED_LOCAL", "AUTHORIZED_FOR_DESTINATION", "PUBLISHED_UNVERIFIED", "VERIFIED_PUBLISHED", "PUBLICATION_FAILED"]},
    "REPRODUCIBILITY_CLASS": {"enum": [
      "PUBLIC_SELF_CONTAINED_REPLAY", "PUBLIC_CODE_AND_HASH_REFERENCES",
      "PRIVATE_SOURCE_DEPENDENCIES", "DOCUMENTARY_ONLY"
    ]},
    "HISTORICAL_REPRODUCIBILITY_CLASS": {"enum": ["PUBLIC_SELF_CONTAINED_REPLAY", "PUBLIC_CODE_AND_HASH_REFERENCES", "PRIVATE_SOURCE_DEPENDENCIES", "DOCUMENTARY_ONLY", "UNKNOWN"]},
    "REQUIRED_RESULT_SET": {"type": "array", "items": {"$ref": "#/$defs/resultArtifact"}, "minItems": 11},
    "publication": {"type": "object"},
    "scope": {"type": "object"},
    "lineage": {"type": "object"},
    "created_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "bytes", "rights", "privacy", "included"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1, "not": {"pattern": "^[A-Za-z]:[\\\\/]|^\\\\\\\\|^/Users/|^/home/"}},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "rights": {"type": "string", "minLength": 1},
        "privacy": {"type": "string", "minLength": 1},
        "included": {"type": "boolean"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "timestamp_utc", "authority_reference", "evidence_reference"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "timestamp_utc": {"type": "string", "format": "date-time"},
        "authority_reference": {"type": "string", "minLength": 1},
        "evidence_reference": {"type": "string", "minLength": 1},
        "disposition_review": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "selected_units", "disposed_units", "manifest_sha256", "review_reference"],
          "properties": {
            "status": {"const": "PASS"},
            "selected_units": {"type": "integer", "minimum": 1},
            "disposed_units": {"type": "integer", "minimum": 1},
            "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "review_reference": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "resultArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "path", "sha256", "reason"],
      "properties": {
        "name": {"enum": ["CAMPAIGN_SUMMARY.md", "EXECUTION_RESULTS.json", "COVERAGE_REPORT.json", "FAILURES_AND_ABSTENTIONS.json", "DEFECT_AND_FIX_REPORT.md", "CODE_REFERENCE.json", "SOURCE_MANIFEST.json", "RESULTS_INTEGRITY_MANIFEST.json", "AUDIT_SUMMARY.md", "LIMITATIONS.md", "PUBLICATION_RECEIPT.json"]},
        "status": {"enum": ["PRESENT", "NOT_PRESENT_IN_HISTORICAL_SCOPE", "NOT_APPLICABLE_WITH_REASON", "UNKNOWN"]},
        "path": {"type": "string"},
        "sha256": {"type": "string"},
        "reason": {"type": "string"}
      }
    }
  }
}
