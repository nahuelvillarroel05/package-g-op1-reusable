{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OP1_FINDING_SCHEMA.json",
  "title": "OP1_FINDING_SCHEMA",
  "description": "Original observation never mutates. OPEN, RESOLVED, ACCEPTED_LIMITATION, FALSE_POSITIVE, SUPERSEDED are derived from appended resolution records.",
  "type": "object",
  "required": [
    "identity",
    "finding_id",
    "subject_ids",
    "observation",
    "severity",
    "evidence_ids",
    "initial_state"
  ],
  "properties": {
    "identity": {
      "$ref": "OP1_IDENTITY_ENVELOPE_SCHEMA.json"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^PG-FND-[0-9a-f]{32}$"
    },
    "subject_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_type",
          "entity_id"
        ],
        "properties": {
          "entity_type": {
            "enum": [
              "PROJECT",
              "PRODUCT",
              "LINEAGE",
              "VERSION",
              "FREEZE",
              "SESSION",
              "RUN",
              "ATTEMPT",
              "AUTHORITY",
              "CLAIM",
              "NAMESPACE",
              "OPERATION",
              "EVENT",
              "ACTOR",
              "MODEL",
              "TOOL",
              "TOOL_INVOCATION",
              "RESOURCE",
              "POLICY",
              "SCHEMA",
              "ARTIFACT",
              "EVIDENCE",
              "FINDING",
              "ERROR",
              "DECISION",
              "AUDIT",
              "DELEGATION",
              "TASK",
              "REPORT",
              "REVIEW",
              "DATASET",
              "DATASET_VERSION",
              "DATASET_EXAMPLE",
              "TRANSFORMATION"
            ]
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "BLOCKING",
        "NONBLOCKING",
        "INFO"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PG-EVD-[0-9a-f]{32}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "initial_state": {
      "const": "OPEN"
    }
  },
  "additionalProperties": false
}